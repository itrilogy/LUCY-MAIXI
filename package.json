{
  "name": "maixi-biopulse",
  "description": "脉息 (MaiXi / PulseStream) - 基于普通摄像头的无感远程生理特征提取平台 · 鹿溪联合创新实验室",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-face-api.cjs && node scripts/setup-onnx.cjs",
    "verify-setup": "node scripts/setup-onnx.cjs",
    "clean": "rimraf public/ort public/models/face-api dist node_modules/.vite",
    "predev": "npm run clean && npm run setup",
    "dev": "vite",
    "prebuild": "npm run clean && npm run setup",
    "build:workers": "tsc --project tsconfig.workers.json",
    "build": "npm run build:workers && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "deploy": "sh deploy.sh"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "face-api.js": "^0.22.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "onnxruntime-web": "^1.17.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/node": "^20.4.2",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.44.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.1.6",
    "vite": "^6.2.6",
    "vitest": "^3.1.1"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "react-refresh"
    ],
    "rules": {
      "react-refresh/only-export-components": "warn"
    }
  }
}
